# Copy to .env and fill in. Never commit .env. All values below are placeholders.

# Optional LLM for rewording case notes. Leave empty to use the template fallback.
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-5-mini

# Reproducibility and paths
JACHAI_SEED=42
JACHAI_DATA_DIR=data
JACHAI_REPORTS_DIR=reports
# Config profile: empty = reference configs, "fast" = small dev world
JACHAI_PROFILE=
MODEL_DIR=models

# Backend API
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated origins allowed to call the API (the dashboard URL)
ALLOWED_ORIGINS=http://localhost:3000
# Existing reports served by GET /metrics, and the append-only decision log
REPORTS_DIR=reports
AUDIT_DB_PATH=data/audit.sqlite3

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
