{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{backend/**,ml/**,configs/**,models/fast/**,data/fast/world/**,reports/fast/**,frontend/public/demo/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index.py/$1" }]
}
